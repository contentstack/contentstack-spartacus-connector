# SAP Composable Storefront (Spartacus) projects require legacy peer-dependency
# resolution — this is SAP's own documented install requirement, not a hack.
#
# Two reasons it's needed here:
#  1. Spartacus's own packages declare a dense web of exact-version @angular/
#     @ngrx peers that npm 7+'s strict resolver rejects.
#  2. This library declares @spartacus/{core,storefront,cart} as peerDependencies
#     at `>=2211.0.0`. SAP's real 2211.x line is published only on SAP's private
#     RBSC registry (public npm caps at an abandoned 4.3.8), so npm's default
#     peer auto-install can't fetch them and aborts with ETARGET. The consuming
#     Spartacus app provides these at build time; here they're type-shimmed
#     (see typings/) for offline typecheck.
#
# This only affects installs run INSIDE this repo (local dev). It does not leak
# to consumers of the published package — their own npm settings apply.
legacy-peer-deps=true
