{
  "title": "Landing Page",
  "uid": "landing_page",
  "description": "Any CMS content page: SAP LandingPage2Template (home / marketing landing) and ContentPage1Template (FAQ, terms, help, campaign pages). Fill only the slots the page's template has.",
  "schema": [
    {
      "display_name": "Title",
      "uid": "title",
      "data_type": "text",
      "mandatory": true,
      "unique": false,
      "multiple": false,
      "non_localizable": false,
      "field_metadata": {
        "_default": true,
        "instruction": "Page title."
      }
    },
    {
      "display_name": "URL",
      "uid": "url",
      "data_type": "text",
      "mandatory": false,
      "unique": false,
      "multiple": false,
      "non_localizable": false,
      "field_metadata": {
        "instruction": "Route this page resolves at. Use \"/\" for the homepage."
      }
    },
    {
      "display_name": "Page Type",
      "uid": "page_type",
      "data_type": "text",
      "mandatory": false,
      "unique": false,
      "multiple": false,
      "non_localizable": false,
      "field_metadata": {
        "instruction": "SAP page type discriminator (e.g. ContentPage / ProductPage / CategoryPage)."
      }
    },
    {
      "display_name": "Template",
      "uid": "template",
      "data_type": "text",
      "mandatory": false,
      "unique": false,
      "multiple": false,
      "non_localizable": false,
      "field_metadata": {
        "instruction": "SAP page template, e.g. \"LandingPage2Template\" (home) or \"ContentPage1Template\" (FAQ, terms). Only that template's slots render."
      }
    },
