      "field_metadata": {
        "ref_multiple": true,
        "ref_multiple_content_types": true,
        "instruction": "Maps to SAP slot BottomHeaderSlot. Under the header, e.g. the page title (a Flex block with flex type PageTitleComponent). Leave empty to keep SAP's."
